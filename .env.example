# Weather Forecast Collector settings
#
# The settings are normally written straight into docker-compose.yml (see
# docker-compose.example.yml, which documents every one). This file lists the
# same names for setups that prefer an env file:
#   docker run --env-file .env ...     or     env_file: .env   in compose
# Never commit a real .env.

# Time zone for every time written
TZ=America/Anchorage

# US zip codes to fetch, comma-separated
ZIP_CODES=99660,99591

# Named coordinates to fetch: Name,lat,lon;Name,lat,lon
# LOCATIONS=Cabin,61.52,-149.63

# Seconds between fetches (NWS refreshes about hourly)
UPDATE_INTERVAL=3600

# Marine forecast (optional)
# MARINE_ZONE=PKZ766
# MARINE_URL=https://tgftp.nws.noaa.gov/data/raw/fz/fzak52.pafc.cwf.alu.txt
# MARINE_ZONE_NAME=Pribilof Islands Nearshore Waters

# How the service identifies itself to NWS: app name plus a contact
# USER_AGENT=my-forecast-collector/1.0 (you@example.com)

# Alerts through ntfy (optional)
# NTFY_URL=https://ntfy.sh
# NTFY_TOPIC=my-forecast-alerts
# NTFY_TOKEN=
